[
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // Split horizontal
      "space s h": "pane::SplitHorizontal",
      // Split vertical
      "space s v": "pane::SplitVertical",
      // Cycle panes
      "ctrl-o": "workspace::ActivateNextPane",
      // Next tab
      "shift-l": "pane::ActivateNextItem",
      // Previous tab
      "shift-h": "pane::ActivatePreviousItem",
    },
  },

  // Sublime-style multicursor
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual || vim_mode == insert) && !menu",
    "bindings": {
      // Select next occurrence
      "ctrl-d": ["editor::SelectNext", { "replace_newest": false }],
      // Skip current occurrence
      "ctrl-k ctrl-d": ["editor::SelectNext", { "replace_newest": true }],
      // Undo cursor
      "ctrl-u": "editor::UndoSelection",
    },
  },

  // Terminal
  {
    "context": "Terminal",
    "bindings": {
      // Focus back to editing pane
      "ctrl-o": "workspace::FocusCenterPane",
    },
  },
]
